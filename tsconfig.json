{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
